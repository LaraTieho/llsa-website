# ─────────────────────────────────────────────────────────────
# LLSA Website — Environment Variables
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Production site URL (no trailing slash)
# Used in SEO metadata (layout.tsx) and JSON-LD schema.
# Update the hardcoded BASE_URL in src/app/layout.tsx to read from this variable.
NEXT_PUBLIC_SITE_URL=https://www.llsa.org.ls

# ── Contact Form ──────────────────────────────────────────────
# Endpoint for the contact form (src/components/contact/ContactContent.tsx).
# The form currently uses a mock 1.2 s delay — replace the onSubmit handler
# with a real POST to this URL (e.g. Resend, Formspree, or a Next.js route handler).
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://api.resend.com/emails

# API key for the contact form provider (server-side only — no NEXT_PUBLIC_ prefix).
# CONTACT_FORM_API_KEY=re_xxxxxxxxxxxx

# ── Analytics (optional) ─────────────────────────────────────
# Google Analytics 4 Measurement ID.
# Add the GA script to src/app/layout.tsx once ready.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
