# ─────────────────────────────────────────────────────────────
# LLSA Website — Environment Variables
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Production site URL (no trailing slash)
# Used in SEO metadata (layout.tsx) and JSON-LD schema.
# Update the hardcoded BASE_URL in src/app/layout.tsx to read from this variable.
NEXT_PUBLIC_SITE_URL=https://www.llsa.org.ls

# ── Contact Form (Web3Forms) ──────────────────────────────────
# Access key from https://web3forms.com, created with geomaticsinstitute.ls@gmail.com.
# Submissions from the Contact page are emailed to that address.
# Public by design (safe in the browser). Set it in Vercel -> Settings ->
# Environment Variables, then redeploy.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ── Analytics (optional) ─────────────────────────────────────
# Google Analytics 4 Measurement ID.
# Add the GA script to src/app/layout.tsx once ready.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
